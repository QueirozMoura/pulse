# URL base da API do Pulse (sem barra no final).
# Desenvolvimento: use "localhost" (não 127.0.0.1) nos DOIS lados. O cookie de sessão é SameSite=Strict:
# localhost:5173 e localhost:3000 são o mesmo "site" (porta não conta), 127.0.0.1 e localhost não são.
# O backend precisa de CORS_ALLOWED_ORIGIN=http://localhost:5173 (veja backend/.env.example).
VITE_API_URL=http://localhost:3000
