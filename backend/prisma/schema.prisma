generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MonitorStatus {
  OPERATIONAL
  UNAVAILABLE
}

model Monitor {
  id                  String        @id @default(uuid()) @db.Uuid
  name                String
  url                 String
  intervalSeconds     Int           @map("interval_seconds")
  active              Boolean       @default(true)
  // false = monitor interno: some da página pública, das métricas e dos incidentes públicos, mas segue checado e visível no painel.
  publicVisible       Boolean       @default(true) @map("public_visible")
  status              MonitorStatus @default(OPERATIONAL)
  consecutiveFailures Int           @default(0) @map("consecutive_failures")
  // Agendamento vive no banco: sobrevive a restarts e permite várias instâncias.
  nextCheckAt         DateTime      @default(now()) @map("next_check_at")
  lastCheckedAt       DateTime?     @map("last_checked_at")
  createdAt           DateTime      @default(now()) @map("created_at")

  checks    CheckResult[]
  incidents Incident[]

  @@index([active, nextCheckAt])
  @@map("monitors")
}

model CheckResult {
  id         String   @id @default(uuid()) @db.Uuid
  monitorId  String   @map("monitor_id") @db.Uuid
  checkedAt  DateTime @default(now()) @map("checked_at")
  success    Boolean
  statusCode Int?     @map("status_code")
  latencyMs  Int      @map("latency_ms")
  // Categoria sanitizada (timeout, dns, connection, tls, http_status, unknown) — nunca a mensagem bruta.
  errorKind  String?  @map("error_kind")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt(sort: Desc)])
  @@map("check_results")
}

model Incident {
  id         String    @id @default(uuid()) @db.Uuid
  monitorId  String    @map("monitor_id") @db.Uuid
  startedAt  DateTime  @default(now()) @map("started_at")
  resolvedAt DateTime? @map("resolved_at")

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  alerts  AlertEvent[]

  @@index([monitorId, startedAt(sort: Desc)])
  @@map("incidents")
}

// Conta única de administrador (o índice parcial na migration impede uma segunda linha).
model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions Session[]

  @@map("admin_users")
}

model Session {
  // SHA-256 (hex) do token do cookie: o token em si nunca é guardado.
  id          String   @id
  adminId     String   @map("admin_id") @db.Uuid
  csrfToken   String   @map("csrf_token")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

// Tentativas de login que falharam (por IP), para limitar força bruta.
model LoginFailure {
  id        String   @id @default(uuid()) @db.Uuid
  ip        String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([ip, createdAt])
  @@map("login_failures")
}

enum AlertKind {
  OPENED
  RESOLVED
}

enum AlertStatus {
  PENDING
  SENT
  FAILED
}

// Outbox de alertas: uma linha por (incidente, tipo), criada na MESMA transação que abre/resolve o incidente.
// O envio acontece depois, fora do scheduler; esta tabela é a fonte da verdade (sobrevive a restart e a falha do provedor).
model AlertEvent {
  id                String      @id @default(uuid()) @db.Uuid
  incidentId        String      @map("incident_id") @db.Uuid
  kind              AlertKind
  status            AlertStatus @default(PENDING)
  attempts          Int         @default(0)
  nextAttemptAt     DateTime    @default(now()) @map("next_attempt_at")
  // Posse temporária (lease) enquanto uma instância envia; expira sozinha se o processo morrer.
  lockedUntil       DateTime?   @map("locked_until")
  lastAttemptAt     DateTime?   @map("last_attempt_at")
  // Categoria sanitizada do último erro (timeout, rate_limited...). Nunca a mensagem do provedor.
  lastErrorKind     String?     @map("last_error_kind")
  providerMessageId String?     @map("provider_message_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  sentAt            DateTime?   @map("sent_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, kind])
  @@index([status, nextAttemptAt])
  @@map("alert_events")
}

// Uma linha por execução do worker one-shot (GitHub Actions). É o "batimento" do sistema de checagens:
// o /health informa a última rodada bem-sucedida a partir daqui. Não guarda segredos nem dados de monitores.
model WorkerRun {
  id             String    @id @default(uuid()) @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  // running | ok | truncated | failed | timeout | cancelled | abandoned
  status         String    @default("running")
  // Origem da execução (schedule, workflow_dispatch, manual): vem de GITHUB_EVENT_NAME, nada sensível.
  trigger        String?
  checksClaimed  Int       @default(0) @map("checks_claimed")
  checksRecorded Int       @default(0) @map("checks_recorded")
  alertsSent     Int       @default(0) @map("alerts_sent")
  alertsRetried  Int       @default(0) @map("alerts_retried")
  alertsFailed   Int       @default(0) @map("alerts_failed")
  errors         Int       @default(0)

  @@index([startedAt])
  @@index([status, finishedAt])
  @@map("worker_runs")
}
