NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Postgres do docker-compose.yml (porta 5433 para não conflitar com um Postgres local)
DATABASE_URL=postgresql://pulse:pulse@localhost:5433/pulse

# Scheduler de checagens
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=5000
SCHEDULER_CONCURRENCY=10
CHECK_TIMEOUT_MS=10000
MIN_INTERVAL_SECONDS=30
# Teto de monitores cadastrados e dias de histórico de checagens mantidos (mín. 7)
MAX_MONITORS=100
CHECK_RETENTION_DAYS=30

# Autenticação (a conta de administrador é criada com `npm run admin -- create`, nunca por env)
SESSION_TTL_HOURS=12
# strict = frontend no mesmo site que a API. none = outro site (exige NODE_ENV=production + CORS_ALLOWED_ORIGIN)
SESSION_COOKIE_SAMESITE=strict
# Origem do frontend para CORS com cookies (UMA origem exata). Em desenvolvimento, o Vite do frontend/.
# Em produção use a origem real, ex.: https://app.exemplo.com. Vazio = sem CORS (o navegador bloqueia o frontend).
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Proxies confiáveis à frente da API (0 em dev; atrás de proxy de hospedagem, normalmente 1)
TRUST_PROXY_HOPS=0
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_IP=5
LOGIN_MAX_FAILURES_GLOBAL=30

# Alertas por e-mail (docs/ALERTS.md). off = padrão; log = só registra no log (desenvolvimento); email = envia pelo Resend
ALERT_DELIVERY=off
# ALERT_EMAIL_TO=voce@exemplo.com
# ALERT_EMAIL_FROM=Pulse <alertas@seudominio.com>
# RESEND_API_KEY=            # segredo: nunca commitar; em produção, só no painel da hospedagem
ALERT_MAX_PER_HOUR=30
